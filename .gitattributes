# Normalize line endings: check out and commit text files with LF.
* text=auto eol=lf

# Explicit text types
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.svg    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf

# Binary assets — never touch line endings
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.ico    binary
